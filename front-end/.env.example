# Endereço do PitcherX-BackEnd (sem barra no final). O navegador chama /backend/... no próprio
# front-end e o Next repassa as requisições para cá — não depende de CORS no backend.
# Copie este arquivo para .env.local e ajuste se o backend não estiver em localhost:8080.
# É lido no build e no `next start`: gere o build novamente ao mudar.
BACKEND_URL=http://localhost:8080

# Opcional: chamar o backend direto do navegador (exige CORS liberado no backend para a
# origem do front-end). Variáveis NEXT_PUBLIC_* são embutidas no build.
# NEXT_PUBLIC_API_URL=http://localhost:8080
