# URL base do PitcherX-BackEnd (sem barra no final).
# Copie este arquivo para .env.local e ajuste se o backend não estiver em localhost:8080.
# O navegador não chama o backend direto: o front repassa /api-backend/* para este endereço
# (evita o erro de CORS). Gere o build novamente (npm run build) ao mudar.
BACKEND_URL=http://localhost:8080
